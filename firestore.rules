rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /*
     * La migración convierte las salas antiguas que no tenían "visibility"
     * en salas públicas. Mientras el marcador no exista, la app puede leer
     * los grupos antiguos y agregar ese campo.
     */
    function migrationPending() {
      return !exists(
        /databases/$(database)/documents/migrations/room-visibility-v1
      );
    }

    function conversationData(conversationId) {
      return get(
        /databases/$(database)/documents/conversations/$(conversationId)
      ).data;
    }

    function conversationDataAfter(conversationId) {
      return getAfter(
        /databases/$(database)/documents/conversations/$(conversationId)
      ).data;
    }

    function memberDataAfter(conversationId, userId) {
      return getAfter(
        /databases/$(database)/documents/conversations/$(conversationId)/members/$(userId)
      ).data;
    }

    function isMember(conversationId) {
      return signedIn()
        && request.auth.uid in conversationData(conversationId).member_ids;
    }

    function hasValidInvite(conversationId) {
      let member = memberDataAfter(conversationId, request.auth.uid);
      let code = member.invite_code;

      return code is string
        && exists(
          /databases/$(database)/documents/room_invites/$(code)
        )
        && get(
          /databases/$(database)/documents/room_invites/$(code)
        ).data.room_id == conversationId
        && get(
          /databases/$(database)/documents/room_invites/$(code)
        ).data.active == true;
    }

    match /profiles/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.username == resource.data.username;

      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.owner_id == request.auth.uid;

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.owner_id == request.auth.uid;
    }

    match /migrations/{migrationId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && migrationId == 'room-visibility-v1'
        && request.resource.data.id == migrationId;

      allow update, delete: if false;
    }

    match /room_invites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.room_id is string
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.active == true
        && conversationDataAfter(request.resource.data.room_id).type == 'group'
        && conversationDataAfter(request.resource.data.room_id).visibility == 'private'
        && conversationDataAfter(request.resource.data.room_id).created_by
          == request.auth.uid;

      allow update: if signedIn()
        && resource.data.created_by == request.auth.uid
        && request.resource.data.room_id == resource.data.room_id
        && request.resource.data.created_by == resource.data.created_by
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['active']);

      allow delete: if signedIn()
        && resource.data.created_by == request.auth.uid;
    }

    match /conversations/{conversationId} {

      /*
       * GET individual:
       * - Permite leer un documento inexistente para que las transacciones
       *   puedan comprobar si una conversación todavía no existe.
       * - Si existe, solo miembros o salas grupales públicas.
       */
      allow get: if signedIn() && (
        resource == null
        || request.auth.uid in resource.data.member_ids
        || (
          resource.data.type == 'group'
          && (
            migrationPending()
            || resource.data.visibility == 'public'
          )
        )
      );

      /*
       * LIST/QUERY:
       * Esta forma coincide exactamente con las consultas de la app:
       * - where(member_ids, array-contains, uid)
       * - where(type, ==, group) + where(visibility, ==, public)
       * - migración temporal: where(type, ==, group)
       */
      allow list: if signedIn() && (
        request.auth.uid in resource.data.member_ids
        || (
          resource.data.type == 'group'
          && (
            migrationPending()
            || resource.data.visibility == 'public'
          )
        )
      );

      allow create: if signedIn()
        && request.resource.data.created_by == request.auth.uid
        && request.auth.uid in request.resource.data.member_ids
        && (
          (
            request.resource.data.type == 'direct'
            && request.resource.data.member_ids.size() == 2
          )
          ||
          (
            request.resource.data.type == 'group'
            && request.resource.data.member_ids.size() == 1
            && request.resource.data.member_ids.hasOnly([request.auth.uid])
            && request.resource.data.visibility in ['public', 'private']
          )
        );

      allow update: if signedIn() && (
        /*
         * Un miembro actualiza último mensaje/fecha.
         */
        (
          request.auth.uid in resource.data.member_ids
          && request.resource.data.member_ids == resource.data.member_ids
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'updated_at',
              'last_message',
              'last_message_at'
            ])
        )
        ||
        /*
         * Un usuario se agrega a una sala pública o entra a una privada
         * mediante un código válido.
         */
        (
          resource.data.type == 'group'
          && !(request.auth.uid in resource.data.member_ids)
          && request.auth.uid in request.resource.data.member_ids
          && request.resource.data.member_ids.size()
            == resource.data.member_ids.size() + 1
          && request.resource.data.member_ids.hasAll(
            resource.data.member_ids
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'member_ids',
              'updated_at'
            ])
          && (
            resource.data.visibility == 'public'
            || hasValidInvite(conversationId)
            || (
              migrationPending()
              && !('visibility' in resource.data)
            )
          )
        )
        ||
        /*
         * Migración de sala antigua: agrega visibility = public.
         */
        (
          migrationPending()
          && resource.data.type == 'group'
          && !('visibility' in resource.data)
          && request.resource.data.visibility == 'public'
          && request.resource.data.member_ids == resource.data.member_ids
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['visibility'])
        )
      );

      allow delete: if false;

      match /members/{userId} {
        allow read: if signedIn() && (
          (
            conversationData(conversationId).type == 'group'
            && (
              conversationData(conversationId).visibility == 'public'
              || isMember(conversationId)
              || (
                migrationPending()
                && !('visibility' in conversationData(conversationId))
              )
            )
          )
          ||
          (
            conversationData(conversationId).type == 'direct'
            && isMember(conversationId)
          )
        );

        allow create: if signedIn() && (
          /*
           * Miembros de una conversación directa.
           */
          (
            conversationDataAfter(conversationId).type == 'direct'
            && request.auth.uid
              in conversationDataAfter(conversationId).member_ids
            && userId
              in conversationDataAfter(conversationId).member_ids
          )
          ||
          /*
           * Creador, unión pública o unión privada con código.
           */
          (
            conversationDataAfter(conversationId).type == 'group'
            && userId == request.auth.uid
            && request.auth.uid
              in conversationDataAfter(conversationId).member_ids
            && (
              conversationDataAfter(conversationId).created_by
                == request.auth.uid
              || conversationDataAfter(conversationId).visibility == 'public'
              || hasValidInvite(conversationId)
              || (
                migrationPending()
                && !(
                  'visibility'
                  in conversationDataAfter(conversationId)
                )
              )
            )
          )
        );

        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.user_id == resource.data.user_id
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'last_read_at',
              'profile',
              'invite_code',
              'joined_at'
            ]);

        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isMember(conversationId);

        allow create: if isMember(conversationId)
          && request.resource.data.sender_id == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && request.resource.data.message_type in ['text', 'system'];

        allow update, delete: if isMember(conversationId)
          && resource.data.sender_id == request.auth.uid;
      }
    }
  }
}